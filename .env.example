# Nomad — every value here is OPTIONAL.
# With none of them set the app runs end to end on its offline engines.
# Copy to .env (backend) and/or frontend/.env.local (frontend) to enable a
# provider. Never commit the filled-in copies.

# ---------------------------------------------------------------- backend ---
# AI: narration, intent classification for phrasings the keywords miss, and
# per-place price estimates. Without it the companion still decides and applies
# every change; it just phrases them from templates.
#
# Groq and OpenAI both speak the OpenAI chat-completions protocol. Set either.
# Groq wins if both are present.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Set false to keep Google's price bands and save one call per trip.
# LLM_PRICING=true

# Live forecasts. Without it a deterministic climate model is used.
# OPENWEATHER_API_KEY=...

# Live destination catalogs: real venues, opening hours, ratings, price levels
# and photos from the Google Places API (New). Without it the curated catalog
# is used. This is a SERVER key and must not be restricted by HTTP referrer.
# Enable "Places API (New)" and "Time Zone API" on it.
# GOOGLE_MAPS_API_KEY=...

# Postgres via Supabase. Without it trips are stored as JSON under
# backend/.data/trips/. Expects a `trips` table:
#   id text primary key, owner text, share_token text,
#   updated_at text, payload jsonb
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=...

# Browser origins allowed to call the API directly. Only needed if you set
# NEXT_PUBLIC_API_URL below; with the default proxy setup there are no
# cross-origin requests at all.
# CORS_ORIGINS=http://localhost:3000

# Create the sample Tokyo trip on an empty store. Set false for a clean deploy.
# SEED_DEMO_TRIP=true

# --------------------------------------------------------------- frontend ---
# Where the SERVER should reach the API. Next also rewrites /api/* here, so the
# browser keeps calling its own origin and CORS never comes into it. Leave
# unset locally (defaults to http://127.0.0.1:8000); set it in a deployment.
# See DEPLOYMENT.md.
# API_URL=https://nomad-api.vercel.app

# Overrides the above and makes the BROWSER call the API directly. Only use
# this if you want cross-origin requests — it also requires CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=https://nomad-api.vercel.app

# Real Google Maps tiles in the browser. Without it the offline coordinate
# projection is drawn instead.
#
# This is PUBLIC — it ships to every visitor — so it must be a DIFFERENT key
# from GOOGLE_MAPS_API_KEY above: restrict it by HTTP referrer to your domain
# and enable only "Maps JavaScript API" on it.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...

# Google Sign-In. Without it, "Continue with Google" signs in a local demo
# profile so the flow is still exercisable.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
