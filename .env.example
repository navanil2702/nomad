# Nomad — every value here is OPTIONAL.
# With none of them set the app runs end to end on its offline engines.
# Copy to .env (backend) and/or frontend/.env.local (frontend) to enable a
# provider. Never commit the filled-in copies.

# ---------------------------------------------------------------- backend ---
# AI narration. Without it the companion still decides and applies every
# change; it just phrases them from templates instead of the model.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Live forecasts. Without it a deterministic climate model is used.
# OPENWEATHER_API_KEY=...

# Real Places photos and tiles. Without it the curated catalog and the
# offline map projection are used. Google Maps *links* work either way.
# GOOGLE_MAPS_API_KEY=...

# Postgres via Supabase. Without it trips are stored as JSON under
# backend/.data/trips/. Expects a `trips` table:
#   id text primary key, owner text, share_token text,
#   updated_at text, payload jsonb
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=...

# Browser origins allowed to call the API directly.
# CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- frontend ---
# Where the browser should reach the API. Leave unset in development: Next
# proxies /api/* to http://127.0.0.1:8000 so requests stay same-origin.
# NEXT_PUBLIC_API_URL=https://api.your-deployment.com

# Google Sign-In. Without it, "Continue with Google" signs in a local demo
# profile so the flow is still exercisable.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
